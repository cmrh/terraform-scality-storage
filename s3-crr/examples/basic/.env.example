# Example Environment Variables for S3 CRR Module
#
# SECURITY: This file is an EXAMPLE only. Do NOT commit actual credentials!
#
# Usage:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual credentials
#   3. Source the file: source .env
#   4. Run terraform: terraform apply
#
# IMPORTANT: .env is in .gitignore and should NEVER be committed

# Source Scality Credentials
export SCALITY_SOURCE_ACCESS_KEY="your-source-access-key-here"
export SCALITY_SOURCE_SECRET_KEY="your-source-secret-key-here"

# Destination Scality Credentials
export SCALITY_DESTINATION_ACCESS_KEY="your-destination-access-key-here"
export SCALITY_DESTINATION_SECRET_KEY="your-destination-secret-key-here"

# Optional: Terraform logging
# export TF_LOG=INFO
# export TF_LOG_PATH=./terraform.log
