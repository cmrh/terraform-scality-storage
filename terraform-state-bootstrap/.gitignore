# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files to ignore
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Keep example files (safe to commit)
!terraform.tfvars.example
!.env.example

# Ignore environment variable files with credentials
.env
.env.local
.env.*.local
