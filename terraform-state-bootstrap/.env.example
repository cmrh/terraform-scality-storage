# Example Environment Variables for Terraform State Bootstrap Module
#
# SECURITY: This file is an EXAMPLE only. Do NOT commit actual credentials!
#
# Usage:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual credentials
#   3. Source the file: source .env
#   4. Run terraform: terraform apply
#
# IMPORTANT: .env is in .gitignore and should NEVER be committed

# Scality Credentials for State Bucket Creation
# These credentials need permissions to create and manage S3 buckets
export AWS_ACCESS_KEY_ID="your-scality-admin-access-key-here"
export AWS_SECRET_ACCESS_KEY="your-scality-admin-secret-key-here"

# Alternatively, use Scality-specific variable names
# export SCALITY_ACCESS_KEY="your-scality-admin-access-key-here"
# export SCALITY_SECRET_KEY="your-scality-admin-secret-key-here"

# Optional: Terraform logging
# export TF_LOG=INFO
# export TF_LOG_PATH=./terraform.log
